{
  "model": "opusplan",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)",
      "Bash(git push -u origin main)",
      "Bash(git pull origin main)",
      "Bash(git fetch *)",
      "Bash(ls *)",
      "Bash(pwd)"
    ],
    "ask": [
      "Bash(git push *live*)",
      "Bash(git checkout live*)",
      "Bash(git switch live*)",
      "Bash(git branch * live*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
